# Configuración de base de datos PostgreSQL
DATABASE_URL=postgresql://stock_app:password@host:5432/sistema_stock

# Clave para cifrar los secretos de la doble verificacion (32 bytes en base64). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# No cambiarla una vez en uso (se perderian los codigos ya configurados). Nunca subirla a git.
APP_KEY=
# 1 = exigir doble verificacion a los administradores tambien en desarrollo (en produccion siempre se exige).
REQUERIR_2FA=

# Cuantos proxies de confianza hay delante de la app. En Easypanel (Traefik) poner 1. Con 0 no se confia en la IP que informa
# el navegador (no se puede falsificar, pero la auditoria y el limite por IP quedan sin IP).
TRUST_PROXY_HOPS=
